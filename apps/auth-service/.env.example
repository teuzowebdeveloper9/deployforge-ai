NODE_ENV=development
PORT=3003
DATABASE_URL="postgresql://deployforge:deployforge_dev_password@localhost:5432/deployforge?schema=public"
JWT_ACCESS_TOKEN_SECRET="replace_me_with_at_least_32_random_bytes"
JWT_ISSUER="deployforge-auth"
JWT_AUDIENCE="deployforge-gateway"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_PEPPER="replace_me_with_another_random_secret"
GATEWAY_INTERNAL_AUTH_TOKEN="replace_me_gateway_internal_auth_token"
